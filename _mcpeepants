#compdef mcpeepants get-server-config.sh

# Zsh completion function for mcpeepants
# Place this file in /usr/share/zsh/site-functions/ or ~/.zsh/completions/

_mcpeepants() {
    local -a servers
    local script_dir servers_file

    # Get script directory and servers file location
    script_dir="${_comps[CURRENT]:h}"
    [[ -z "$script_dir" ]] && script_dir="$(dirname ${funcsourcetrace[1]%:*})"
    servers_file="$script_dir/servers.json"

    # Fallback to current directory if script detection fails
    [[ ! -f "$servers_file" ]] && servers_file="./servers.json"

    # Extract server names from servers.json
    if [[ -f "$servers_file" ]]; then
        if command -v jq >/dev/null 2>&1; then
            servers=($(jq -r 'keys[]' "$servers_file" 2>/dev/null))
        else
            # Fallback without jq
            servers=($(grep -oE '"[^"]+":\s*\{' "$servers_file" 2>/dev/null | grep -oE '"[^"]+"' | tr -d '"'))
        fi
    else
        # Default server list if servers.json not found
        servers=(
            'desktop-commander'
            'playwright'
            'zai-mcp-server'
            'sequential-thinking'
            'chrome-devtools'
            'serena'
            'context7'
            'video-processing'
            'mermaid-mcp-server'
            'brave-search'
            'tavily'
            'z-ai-web-search-prime'
        )
    fi

    local -a options=(
        '--all[Generate configuration with all available MCP servers]'
        '--list[List all available MCP servers]'
        '--search[Search servers by name, keyword, or description]:search query:'
        '--help[Show help message]'
        '-h[Show help message]'
        '-l[List all available MCP servers]'
    )

    # Main completion logic
    _arguments -C \
        '1: :->first_arg' \
        '*: :->args' \
        && return 0

    case "$state" in
        first_arg)
            if [[ "$words[2]" == "--search" ]]; then
                # No completion for search query - let user type freely
                _message 'search query'
            else
                _alternative \
                    'options:option:((options\:"'"${(j:;:)options}"'"'))' \
                    'servers:server:_values -s , "servers" $servers'
            fi
            ;;
        args)
            if [[ "$words[CURRENT-1]" == "--search" ]]; then
                _message 'search query'
            else
                # Complete servers for additional arguments
                _values -s , "servers" $servers
            fi
            ;;
    esac
}

_mcpeepants "$@"